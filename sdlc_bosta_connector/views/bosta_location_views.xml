<odoo>
    <record id="view_bosta_city_list" model="ir.ui.view">
        <field name="name">bosta.city.list</field>
        <field name="model">bosta.city</field>
        <field name="arch" type="xml">
            <list string="Bosta Cities">
                <field name="name"/>
                <field name="other_name" optional="show"/>
                <field name="code"/>
                <field name="instance_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bosta_city_form" model="ir.ui.view">
        <field name="name">bosta.city.form</field>
        <field name="model">bosta.city</field>
        <field name="arch" type="xml">
            <form string="Bosta City">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="other_name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="instance_id"/>
                            <field name="bosta_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zones">
                            <field name="zone_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="other_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bosta_city_search" model="ir.ui.view">
        <field name="name">bosta.city.search</field>
        <field name="model">bosta.city</field>
        <field name="arch" type="xml">
            <search string="Bosta Cities">
                <field name="name"/>
                <field name="code"/>
                <field name="other_name"/>
            </search>
        </field>
    </record>

    <record id="action_bosta_city" model="ir.actions.act_window">
        <field name="name">Bosta Cities</field>
        <field name="res_model">bosta.city</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Bosta cities cached yet</p>
            <p>Open the Bosta account and use "Sync Address Catalogue" to
               download Bosta's city, zone and district lists. This is a
               read-only call and books nothing.</p>
        </field>
    </record>

    <record id="view_bosta_zone_list" model="ir.ui.view">
        <field name="name">bosta.zone.list</field>
        <field name="model">bosta.zone</field>
        <field name="arch" type="xml">
            <list string="Bosta Zones">
                <field name="city_id"/>
                <field name="name"/>
                <field name="other_name" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_bosta_zone" model="ir.actions.act_window">
        <field name="name">Bosta Zones</field>
        <field name="res_model">bosta.zone</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_partner_form_bosta" model="ir.ui.view">
        <field name="name">res.partner.form.bosta</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="bosta_city_id"
                       groups="sdlc_bosta_connector.group_bosta_user"/>
                <field name="bosta_zone_id"
                       groups="sdlc_bosta_connector.group_bosta_user"/>
                <field name="bosta_district_id"
                       groups="sdlc_bosta_connector.group_bosta_user"/>
            </xpath>
        </field>
    </record>
</odoo>
