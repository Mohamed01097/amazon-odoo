<odoo>
    <record id="view_bosta_instance_form" model="ir.ui.view">
        <field name="name">bosta.instance.form</field>
        <field name="model">bosta.instance</field>
        <field name="arch" type="xml">
            <form string="Bosta Account">
                <header>
                    <button name="action_sync_address_catalogue" type="object"
                            string="Sync Address Catalogue" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="sdlc_bosta_connector.action_bosta_city" type="action" class="oe_stat_button"
                                icon="fa-map-marker">
                            <field name="city_count" widget="statinfo" string="Cities"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Bosta Main Account"/></h1>
                    </div>
                    <group>
                        <group string="Credentials">
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="api_base_url"/>
                            <field name="api_key" password="True"/>
                            <field name="api_token" password="True"/>
                        </group>
                        <group string="Pickup &amp; Options">
                            <field name="shipment_booking_enabled"/>
                            <field name="pickup_location_code"/>
                            <field name="warehouse_id"/>
                            <field name="default_cod_enabled"/>
                            <field name="last_catalogue_sync_at"/>
                        </group>
                    </group>
                    <group string="Status Webhook">
                        <field name="webhook_url" placeholder="https://your-odoo/bosta/webhook/status"/>
                        <field name="webhook_auth_header_name"/>
                        <field name="webhook_secret" password="True"/>
                    </group>
                    <notebook>
                        <page string="Delivery Methods">
                            <field name="carrier_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="bosta_flat_rate"/>
                                    <field name="integration_level"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bosta_instance_list" model="ir.ui.view">
        <field name="name">bosta.instance.list</field>
        <field name="model">bosta.instance</field>
        <field name="arch" type="xml">
            <list string="Bosta Accounts">
                <field name="name"/>
                <field name="pickup_location_code"/>
                <field name="warehouse_id"/>
                <field name="shipment_booking_enabled"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_bosta_instance" model="ir.actions.act_window">
        <field name="name">Bosta Accounts</field>
        <field name="res_model">bosta.instance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
