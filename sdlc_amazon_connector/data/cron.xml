    <record id="cron_amazon_health_scores" model="ir.cron">
        <field name="name">Amazon: Calculate Product Health Scores</field>
        <field name="model_id" ref="model_amazon_product_health"/>
        <field name="state">code</field>
        <field name="code">
for inst in env['amazon.instance'].search([]):
    model.calculate_all_health_scores(inst.id)
</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
