        <field name="model_id" ref="model_amazon_settlement_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.clear()]"/>
    </record>

    <record id="rule_amazon_settlement_line_company" model="ir.rule">
