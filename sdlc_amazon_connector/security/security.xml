        <field name="name">Amazon managers see company sync logs</field>
        <field name="model_id" ref="model_amazon_sync_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('sdlc_amazon_connector.group_amazon_manager'))]"/>
