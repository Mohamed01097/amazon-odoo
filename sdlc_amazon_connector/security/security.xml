        <field name="model_id" ref="model_amazon_sync_log"/>
        <field name="domain_force">[('responsible_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('sdlc_amazon_connector.group_amazon_user'))]"/>
