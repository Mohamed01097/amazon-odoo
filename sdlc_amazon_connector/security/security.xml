<odoo>
    <record id="module_category_sdlc_amazon_connector" model="ir.module.category">
        <field name="name">Amazon Connector</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_amazon_connector" model="res.groups.privilege">
        <field name="name">Amazon Connector</field>
        <field name="category_id" ref="module_category_sdlc_amazon_connector"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_amazon_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_amazon_connector"/>
    </record>

    <record id="group_amazon_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_amazon_connector"/>
        <field name="implied_ids" eval="[
            Command.link(ref('sdlc_amazon_connector.group_amazon_user')),
            Command.link(ref('stock.group_stock_user')),
        ]"/>
    </record>

    <record id="group_amazon_technical_admin" model="res.groups">
        <field name="name">Technical Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_amazon_connector"/>
        <field name="implied_ids" eval="[
            Command.link(ref('sdlc_amazon_connector.group_amazon_manager')),
            Command.link(ref('base.group_system')),
        ]"/>
    </record>

    <record id="rule_amazon_instance_company" model="ir.rule">
        <field name="name">Amazon instances by company</field>
        <field name="model_id" ref="model_amazon_instance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('sdlc_amazon_connector.group_amazon_user'))]"/>
    </record>

