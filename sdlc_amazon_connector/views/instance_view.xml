<odoo>
    <record id="amazon_instance_action" model="ir.actions.act_window">
        <field name="name">Amazon Instances</field>
        <field name="res_model">amazon.instance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="amazon_instance_list" model="ir.ui.view">
        <field name="name">amazon.instance.list</field>
        <field name="model">amazon.instance</field>
        <field name="arch" type="xml">
            <list string="Amazon Instances">
                <field name="name"/>
                <field name="seller_id"/>
                <field name="marketplace_id"/>
                <field name="region"/>
                <field name="product_count"/>
                <field name="order_count"/>
                <field name="last_order_sync"/>
            </list>
        </field>
    </record>

    <record id="amazon_instance_form" model="ir.ui.view">
        <field name="name">amazon.instance.form</field>
        <field name="model">amazon.instance</field>
        <field name="arch" type="xml">
            <form string="Amazon Instance">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_full_sync" type="object" string="Full Sync" class="btn-warning" icon="fa-refresh" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_sync_products" type="object" string="Sync Products" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_open_product_setup_wizard" type="object" string="Product Setup" class="btn-secondary" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_link_products_by_sku" type="object" string="Link Existing Products by SKU" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_create_missing_odoo_products" type="object" string="Create Missing Odoo Products" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_import_orders" type="object" string="Import Orders" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_sync_order_statuses" type="object" string="Sync Order Statuses" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_export_stock" type="object" string="Export Stock" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_pull_stock" type="object" string="Reconcile FBA Inventory" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_update_prices" type="object" string="Push Prices" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_pull_prices" type="object" string="Pull Prices (Amazon→Odoo)" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_export_all_products" type="object" string="Export Products" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_import_settlement_reports" type="object" string="Import Settlements" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_check_canceled_orders" type="object" string="Check Cancellations" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_import_removal_orders" type="object" string="Import Removals" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_import_fba_customer_returns" type="object" string="Import FBA Returns" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_import_fba_inventory_adjustments" type="object" string="Import Adjustments" groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_import_fba_reimbursements" type="object" string="Import Reimbursements" groups="sdlc_amazon_connector.group_amazon_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cube">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_settlements" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="settlement_count" widget="statinfo" string="Settlements"/>
                        </button>
                        <button name="action_view_sync_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="sync_log_count" widget="statinfo" string="Sync Logs"/>
                        </button>
                        <button name="action_view_inventory_audits" type="object" class="oe_stat_button" icon="fa-balance-scale">
                            <field name="reconciliation_run_count" widget="statinfo" string="Inventory Audits"/>
                        </button>
                    </div>
                    <group>
                        <group string="Credentials" groups="sdlc_amazon_connector.group_amazon_technical_admin">
                            <field name="name"/>
                            <field name="seller_id"/>
                            <field name="marketplace_id"/>
                            <field name="region"/>
                            <field name="refresh_token" password="True"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="aws_access_key"/>
                            <field name="aws_secret_key" password="True"/>
                        </group>
                        <group string="Configuration">
                            <field name="company_id"/>
                            <field name="fulfillment_program"/>
                            <field name="fbm_warehouse_id"/>
                            <field name="default_currency_id"/>
                            <field name="initial_order_import_from"/>
                            <field name="initial_order_import_to"/>
                            <field name="order_import_batch_size"/>
                            <field name="order_import_overlap_minutes"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Amazon Settlement Accounting"
                               groups="account.group_account_user,account.group_account_manager"/>
                    <div class="alert alert-info" role="alert" colspan="2"
                         groups="account.group_account_user,account.group_account_manager">
                        Settlement entries are created in draft and use Amazon Clearing. They never post directly to a bank account. Unknown categories block creation.
                    </div>
                    <group groups="account.group_account_user,account.group_account_manager">
                        <group string="Journal and Clearing">
                            <field name="settlement_journal_id"/>
                            <field name="amazon_payout_bank_journal_id"/>
                            <field name="amazon_clearing_account_id"/>
                            <field name="amazon_suspense_account_id"/>
                        </group>
                        <group string="Sales, Refunds and Charges">
                            <field name="amazon_sales_account_id"/>
                            <field name="amazon_refund_account_id"/>
                            <field name="amazon_shipping_account_id"/>
                            <field name="amazon_tax_account_id"/>
                            <field name="amazon_promotion_account_id"/>
                        </group>
                        <group string="Amazon Fees and Compensation">
                            <field name="amazon_fee_account_id"/>
                            <field name="amazon_fba_fee_account_id"/>
                            <field name="amazon_reimbursement_account_id"/>
                            <field name="amazon_adjustment_account_id"/>
                        </group>
                        <group string="Other Settlement Amounts">
                            <field name="amazon_other_credit_account_id"/>
                            <field name="amazon_other_debit_account_id"/>
                        </group>
                    </group>
                    <separator string="FBA Stock Structure"
                               groups="sdlc_amazon_connector.group_amazon_manager,stock.group_stock_manager"/>
                    <group groups="sdlc_amazon_connector.group_amazon_manager,stock.group_stock_manager">
                        <group string="FBA Locations">
                            <field name="fba_warehouse_id"/>
                            <field name="fba_source_location_id"/>
                            <field name="fba_ship_from_partner_id"
                                   context="{'default_company_id': company_id}"/>
                            <field name="fba_transit_location_id"/>
                            <field name="fba_received_location_id"/>
                            <field name="fba_sellable_location_id"/>
                            <field name="fba_reserved_location_id"/>
                            <field name="fba_unsellable_location_id"/>
                            <field name="fba_return_source_location_id"/>
                            <field name="fba_removal_transit_location_id"/>
                            <field name="fba_disposal_location_id"/>
                            <field name="fba_removal_return_partner_id" context="{'default_company_id': company_id}"/>
                            <field name="return_stock_policy"/>
                            <field name="adjustment_stock_policy"/>
                            <field name="inventory_reconciliation_enabled"/>
                            <field name="last_inventory_audit_at"/>
                        </group>
                        <group string="Setup">
                            <div class="alert alert-info" role="alert" colspan="2">
                                <strong>Source</strong> is the client's warehouse stock location.<br/>
                                <strong>Ship-From Address</strong> is the physical address sent to Amazon for inbound planning.<br/>
                                <strong>Transit</strong> is inventory sent to Amazon but not received yet.<br/>
                                <strong>Received/Staging</strong> is physically received inventory whose Amazon disposition is not yet reconciled.<br/>
                                <strong>Sellable</strong> is inventory Amazon has received and can sell.<br/>
                                <strong>Reserved</strong> is inventory Amazon has reserved.<br/>
                                <strong>Unsellable</strong> is inventory Amazon holds but cannot sell.
                                <br/><strong>Removal Transit</strong> holds dispatched removals until physical receipt.
                                <br/><strong>Disposal/Loss</strong> is the auditable destination for confirmed loss events.
                            </div>
                            <button name="action_create_fba_stock_structure"
                                    type="object"
                                    string="Create FBA Stock Structure"
                                    class="btn-primary"
                                    icon="fa-sitemap"
                                    groups="sdlc_amazon_connector.group_amazon_manager,stock.group_stock_manager"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Amazon SKU should match the Odoo product Internal Reference. Sync Products creates Amazon marketplace records only; use Product Setup to link or create Odoo products. After setup, Odoo is master for stock and prices.
                    </div>
                    <group>
                        <group string="AI Configuration">
                            <field name="ai_provider"/>
                            <field name="ai_api_key" password="True"/>
                            <field name="ai_model" placeholder="e.g. llama-3.3-70b-versatile"/>
                            <field name="ai_connection_status" readonly="1"/>
                            <button name="action_test_ai_connection" type="object" string="Test AI Connection" class="btn-warning" icon="fa-bolt"/>
                        </group>
                        <group string="Last Sync">
                            <field name="last_product_sync"/>
                            <field name="last_order_sync"/>
                            <field name="last_stock_sync"/>
                            <field name="last_fba_return_sync_at"/>
                            <field name="last_fba_removal_sync_at"/>
                            <field name="last_fba_adjustment_sync_at"/>
                            <field name="last_fba_reimbursement_sync_at"/>
                            <field name="last_settlement_sync_at"/>
                        </group>
                    </group>

                    <separator string="Auto Sync Scheduler"/>
                    <div class="alert alert-info" role="alert">
                        <field name="auto_sync_enabled" class="oe_inline"/>
                        <label for="auto_sync_enabled" string=" Enable Auto Sync — scheduled sync never runs Amazon → Odoo stock or price pulls."/>
                    </div>
                    <group invisible="not auto_sync_enabled">
                        <group string="Amazon Sync Intervals">
                            <field name="order_sync_interval"/>
                            <field name="product_sync_interval"/>
                            <field name="stock_push_interval"/>
                            <field name="stock_pull_interval" readonly="1"/>
                            <field name="price_push_interval"/>
                            <field name="price_pull_interval" readonly="1"/>
                            <field name="settlement_sync_interval"/>
                            <field name="alert_scan_interval"/>
                        </group>
                        <group string="AI Auto-Run Intervals">
                            <field name="ai_pricing_interval"/>
                            <field name="ai_listing_interval"/>
                            <field name="ai_forecast_interval"/>
                            <field name="ai_review_interval"/>
                            <field name="ai_health_interval"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not auto_sync_enabled">
                        Inventory Audit compares Amazon with Odoo and records suggestions. Pull Prices remains manual. Inventory is never changed automatically unless Settings explicitly selects Automatic reconciliation mode.
                    </div>
                    <group invisible="not auto_sync_enabled">
                        <button name="action_apply_sync_schedule" type="object" string="Apply Schedule" class="btn-primary" icon="fa-clock-o"/>
                    </group>

                    <separator string="Order Status Synchronization"/>
                    <group>
                        <group string="Status Sync Scheduler">
                            <field name="order_status_sync_enabled"/>
                            <field name="order_status_sync_interval"/>
                            <field name="last_status_sync_at"/>
                            <field name="status_sync_lookback_minutes"/>
                            <field name="status_sync_batch_size"/>
                        </group>
                        <group string="Safe Workflow Automation">
                            <field name="auto_confirm_sale_order_on_unshipped"/>
                            <field name="auto_confirm_sale_order_on_shipped"/>
                            <field name="auto_cancel_draft_sale_order_on_amazon_cancellation"/>
                            <field name="auto_cancel_confirmed_sale_order_when_safe"/>
                            <field name="auto_validate_delivery_on_shipped"/>
                            <field name="auto_create_invoice_on_shipped"/>
                            <field name="auto_post_invoice"/>
                            <field name="create_activity_on_status_conflict"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Amazon Status is synchronized Amazon → Odoo and kept separate from the Odoo Sale Order state. Delivery validation, invoice creation/posting, and confirmed-order cancellation are disabled by default.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
