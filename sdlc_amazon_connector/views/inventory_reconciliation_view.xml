<odoo>
    <record id="amazon_inventory_reconciliation_search" model="ir.ui.view">
        <field name="name">amazon.inventory.reconciliation.search</field>
        <field name="model">amazon.inventory.reconciliation</field>
        <field name="arch" type="xml">
            <search string="Inventory Differences">
                <field name="sku"/>
                <field name="odoo_product_id"/>
                <field name="instance_id"/>
                <field name="run_id"/>
                <filter name="pending" string="Pending Review"
                        domain="[('status', 'in', ('mismatch', 'pending_review', 'unmapped', 'not_returned', 'error', 'failed'))]"/>
                <filter name="mismatch" string="Differences"
                        domain="[('status', '!=', 'matched')]"/>
                <filter name="critical" string="Critical"
                        domain="[('severity', '=', 'critical')]"/>
                <filter name="unmapped" string="Unmapped SKU"
                        domain="[('status', '=', 'unmapped')]"/>
                <filter name="not_returned" string="Not Returned"
                        domain="[('status', '=', 'not_returned')]"/>
                <separator/>
                <filter name="matched" string="Matched"
                        domain="[('status', '=', 'matched')]"/>
                <filter name="applied" string="Applied"
                        domain="[('status', '=', 'applied')]"/>
                <group>
                    <filter name="group_run" string="Audit Run" context="{'group_by': 'run_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_action" string="Suggested Action" context="{'group_by': 'suggested_action'}"/>
                    <filter name="group_instance" string="Instance" context="{'group_by': 'instance_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="amazon_inventory_reconciliation_list" model="ir.ui.view">
        <field name="name">amazon.inventory.reconciliation.list</field>
        <field name="model">amazon.inventory.reconciliation</field>
        <field name="arch" type="xml">
            <list string="Amazon Inventory Reconciliation"
                  decoration-success="status == 'matched'"
                  decoration-warning="severity == 'warning' and status not in ('matched', 'applied', 'ignored')"
                  decoration-danger="severity == 'critical' and status not in ('matched', 'applied', 'ignored')"
                  create="0" delete="0">
                <field name="run_date"/>
                <field name="instance_id" optional="show"/>
                <field name="sku"/>
                <field name="marketplace_id" optional="hide"/>
                <field name="asin" optional="hide"/>
                <field name="fnsku" optional="hide"/>
                <field name="odoo_product_id"/>
                <field name="amazon_sellable" string="Amazon Sellable" optional="show"/>
                <field name="odoo_sellable" string="Odoo Sellable" optional="show"/>
                <field name="difference_sellable" string="Sellable Diff" optional="show"/>
                <field name="pending_sale_event_qty" optional="show"/>
                <field name="sale_overlap_state" optional="show"/>
                <field name="amazon_reserved" string="Amazon Reserved" optional="hide"/>
                <field name="odoo_reserved" string="Odoo Reserved" optional="hide"/>
                <field name="difference_reserved" string="Reserved Diff" optional="show"/>
                <field name="amazon_unsellable" string="Amazon Unsellable" optional="hide"/>
                <field name="odoo_unsellable" string="Odoo Unsellable" optional="hide"/>
                <field name="difference_unsellable" string="Unsellable Diff" optional="show"/>
                <field name="amazon_inbound" string="Amazon Physical Inbound" optional="show"/>
                <field name="odoo_transit" string="Odoo Transit" optional="show"/>
                <field name="difference_inbound" string="Inbound Diff" optional="show"/>
                <field name="odoo_received" optional="hide"/>
                <field name="suggested_action"/>
                <field name="severity"/>
                <field name="status"/>
                <button name="action_ignore_difference" type="object"
                        string="Ignore Difference"
                        groups="sdlc_amazon_connector.group_amazon_manager,stock.group_stock_manager"
                        invisible="status not in ('mismatch', 'pending_review', 'unmapped', 'not_returned', 'error', 'failed')"/>
            </list>
        </field>
    </record>

    <record id="amazon_inventory_reconciliation_form" model="ir.ui.view">
        <field name="name">amazon.inventory.reconciliation.form</field>
        <field name="model">amazon.inventory.reconciliation</field>
        <field name="arch" type="xml">
            <form string="Amazon Inventory Reconciliation" create="0" delete="0">
                <header>
                    <button name="action_mark_adjustment_reviewed" type="object"
                            string="Mark Transfer Reviewed" class="btn-secondary"
                            groups="sdlc_amazon_connector.group_amazon_manager,stock.group_stock_manager"
                            invisible="status not in ('mismatch', 'pending_review') or adjustment_reviewed"/>
                    <button name="action_apply_suggested_action" type="object"
                            string="Apply Reconciliation" class="btn-primary"
                            groups="sdlc_amazon_connector.group_amazon_manager,stock.group_stock_manager"
                            invisible="status not in ('mismatch', 'pending_review') or not adjustment_reviewed"/>
                    <button name="action_ignore_difference" type="object"
                            string="Ignore Difference"
                            groups="sdlc_amazon_connector.group_amazon_manager,stock.group_stock_manager"
                            invisible="status not in ('mismatch', 'pending_review', 'unmapped', 'not_returned', 'error', 'failed')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_transfers" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                invisible="not applied_picking_id">
                            <field name="applied_picking_id" widget="statinfo" string="Transfer"/>
                        </button>
                    </div>
                    <group>
                        <group string="Audit">
                            <field name="run_id"/>
                            <field name="run_date"/>
                            <field name="instance_id"/>
                            <field name="sku"/>
                            <field name="marketplace_id"/>
                            <field name="asin"/>
                            <field name="fnsku"/>
                            <field name="amazon_condition"/>
                            <field name="amazon_last_updated_raw"/>
                            <field name="amazon_returned"/>
                            <field name="amazon_product_id"/>
                            <field name="odoo_product_id"/>
                        </group>
                        <group string="Decision">
                            <field name="suggested_action"/>
                            <field name="severity"/>
                            <field name="pending_sale_event_qty"/>
                            <field name="sale_overlap_state"/>
                            <field name="applied_picking_id"/>
                            <field name="applied_at"/>
                            <field name="applied_by_id"/>
                        </group>
                    </group>
                    <group string="Quantity Comparison" col="5">
                        <div class="o_form_label">Bucket</div>
                        <div class="o_form_label">Amazon</div>
                        <div class="o_form_label">Odoo</div>
                        <div class="o_form_label">Difference (Amazon − Odoo)</div>
                        <separator/>
                        <div class="o_form_label">Sellable</div>
                        <field name="amazon_sellable" nolabel="1"/>
                        <field name="odoo_sellable" nolabel="1"/>
                        <field name="difference_sellable" nolabel="1"/>
                        <separator/>
                        <div class="o_form_label">Reserved</div>
                        <field name="amazon_reserved" nolabel="1"/>
                        <field name="odoo_reserved" nolabel="1"/>
                        <field name="difference_reserved" nolabel="1"/>
                        <separator/>
                        <div class="o_form_label">Unsellable</div>
                        <field name="amazon_unsellable" nolabel="1"/>
                        <field name="odoo_unsellable" nolabel="1"/>
                        <field name="difference_unsellable" nolabel="1"/>
                        <separator/>
                        <div class="o_form_label">Physical Inbound / Transit</div>
                        <field name="amazon_inbound" nolabel="1"/>
                        <field name="odoo_transit" nolabel="1"/>
                        <field name="difference_inbound" nolabel="1"/>
                    </group>
                    <group string="Amazon Inbound Detail">
                        <field name="amazon_inbound_working"/>
                        <field name="amazon_inbound_shipped"/>
                        <field name="amazon_inbound_receiving"/>
                        <field name="amazon_total"/>
                        <field name="odoo_received"/>
                    </group>
                    <group string="Amazon Reserved Breakdown">
                        <field name="amazon_reserved_customer_orders"/>
                        <field name="amazon_reserved_fc_transfers"/>
                        <field name="amazon_reserved_fc_processing"/>
                    </group>
                    <group string="Controlled Reconciliation Transfer"
                           groups="sdlc_amazon_connector.group_amazon_manager,stock.group_stock_manager">
                        <div class="alert alert-warning" role="alert" colspan="2">
                            A snapshot does not prove a disposition event. Choose a transfer only
                            after reviewing external evidence. Transit cannot be adjusted here.
                        </div>
                        <group>
                            <field name="adjustment_action"
                                   readonly="status not in ('mismatch', 'pending_review')"/>
                            <field name="adjustment_quantity"
                                   readonly="status not in ('mismatch', 'pending_review')"/>
                            <field name="large_adjustment_confirmed"
                                   readonly="status not in ('mismatch', 'pending_review')"/>
                            <field name="adjustment_reason"
                                   readonly="status not in ('mismatch', 'pending_review')"/>
                        </group>
                        <group>
                            <field name="adjustment_reviewed"/>
                            <field name="reviewed_at"/>
                            <field name="reviewed_by_id"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="not error_message"/>
                    <notebook>
                        <page string="Raw Amazon Response"
                              groups="sdlc_amazon_connector.group_amazon_manager">
                            <field name="raw_response" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="amazon_inventory_reconciliation_action" model="ir.actions.act_window">
        <field name="name">Inventory Differences</field>
        <field name="res_model">amazon.inventory.reconciliation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="amazon_inventory_reconciliation_search"/>
        <field name="context">{'search_default_mismatch': 1}</field>
    </record>

    <record id="amazon_inventory_reconciliation_run_list" model="ir.ui.view">
        <field name="name">amazon.inventory.reconciliation.run.list</field>
        <field name="model">amazon.inventory.reconciliation.run</field>
        <field name="arch" type="xml">
            <list string="Amazon Inventory Audits" create="0" delete="0"
                  decoration-danger="state == 'failed'"
                  decoration-success="state == 'completed' and issue_count == 0"
                  decoration-warning="state == 'completed' and issue_count &gt; 0">
                <field name="name"/>
                <field name="run_date"/>
                <field name="instance_id"/>
                <field name="trigger"/>
                <field name="mode"/>
                <field name="products_checked"/>
                <field name="amazon_records_read"/>
                <field name="matched_count"/>
                <field name="issue_count"/>
                <field name="mismatch_count"/>
                <field name="unmapped_count"/>
                <field name="not_returned_count"/>
                <field name="error_count"/>
                <field name="critical_count"/>
                <field name="pending_review_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="amazon_inventory_reconciliation_run_form" model="ir.ui.view">
        <field name="name">amazon.inventory.reconciliation.run.form</field>
        <field name="model">amazon.inventory.reconciliation.run</field>
        <field name="arch" type="xml">
            <form string="Inventory Health" create="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry Audit"
                            class="btn-primary" invisible="state != 'failed'"
                            groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button name="action_open_differences" type="object"
                            string="Open Differences" class="btn-primary"
                            invisible="state != 'completed' or issue_count == 0"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="products_checked" widget="statinfo" string="Products Checked"/>
                        </button>
                        <button name="action_open_lines" type="object"
                                class="oe_stat_button" icon="fa-check">
                            <field name="matched_count" widget="statinfo" string="Matched"/>
                        </button>
                        <button name="action_open_differences" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="issue_count" widget="statinfo" string="Issues"/>
                        </button>
                        <button name="action_open_differences" type="object"
                                class="oe_stat_button" icon="fa-bolt">
                            <field name="critical_count" widget="statinfo" string="Critical"/>
                        </button>
                        <button name="action_open_differences" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <field name="pending_review_count" widget="statinfo" string="Pending Review"/>
                        </button>
                        <button name="action_open_transfers" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                invisible="transfer_count == 0">
                            <field name="transfer_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Manual Review"
                            bg_color="text-bg-warning"
                            invisible="state != 'completed' or mismatch_count == 0"/>
                    <group>
                        <group string="Inventory Health">
                            <field name="name"/>
                            <field name="instance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="run_date"/>
                            <field name="trigger"/>
                            <field name="mode"/>
                            <field name="snapshot_complete"/>
                            <field name="page_count"/>
                            <field name="amazon_records_read"/>
                            <field name="completed_at"/>
                        </group>
                        <group string="Background Job">
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="next_run_at"/>
                            <field name="retry_after_seconds"/>
                            <field name="amazon_request_ids"
                                   groups="sdlc_amazon_connector.group_amazon_manager"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Amazon inboundWorking, inboundShipped, and inboundReceiving are
                        displayed separately. Physical inbound visibility uses shipped plus
                        receiving for comparison with Odoo Transit, but never changes Transit.
                        Missing mapped SKUs are marked Not Returned and are never treated as zero.
                    </div>
                    <field name="last_error" invisible="not last_error"/>
                    <notebook>
                        <page string="Reconciliation">
                            <field name="reconciliation_ids" readonly="1">
                                <list decoration-success="status == 'matched'"
                                      decoration-danger="severity == 'critical' and status not in ('matched', 'applied', 'ignored')">
                                    <field name="sku"/>
                                    <field name="odoo_product_id"/>
                                    <field name="amazon_returned"/>
                                    <field name="difference_sellable" string="Sellable Diff"/>
                                    <field name="pending_sale_event_qty" optional="show"/>
                                    <field name="sale_overlap_state" optional="show"/>
                                    <field name="difference_reserved" string="Reserved Diff"/>
                                    <field name="difference_unsellable" string="Unsellable Diff"/>
                                    <field name="difference_inbound" string="Inbound Diff"/>
                                    <field name="suggested_action"/>
                                    <field name="severity"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Raw Amazon Response"
                              groups="sdlc_amazon_connector.group_amazon_manager">
                            <field name="raw_response" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="amazon_inventory_reconciliation_run_action" model="ir.actions.act_window">
        <field name="name">Inventory Health</field>
        <field name="res_model">amazon.inventory.reconciliation.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
