<odoo>
    <record id="amazon_inbound_shipment_action" model="ir.actions.act_window">
        <field name="name">Inbound Shipments</field>
        <field name="res_model">amazon.inbound.shipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="amazon_inbound_shipment_list" model="ir.ui.view">
        <field name="name">amazon.inbound.shipment.list</field>
        <field name="model">amazon.inbound.shipment</field>
        <field name="arch" type="xml">
            <list string="Inbound Shipments">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="shipment_name"/>
                <field name="destination_fulfillment_center"/>
                <field name="state"/>
                <field name="carrier_name"/>
                <field name="ship_date"/>
                <field name="instance_id"/>
            </list>
        </field>
    </record>

    <record id="amazon_inbound_shipment_form" model="ir.ui.view">
        <field name="name">amazon.inbound.shipment.form</field>
        <field name="model">amazon.inbound.shipment</field>
        <field name="arch" type="xml">
            <form string="Inbound Shipment">
                <header>
                    <button name="action_create_shipment_plan" type="object" string="Create Shipment Plan" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_submit_shipment" type="object" string="Submit Shipment" invisible="state not in ('draft','planning')"/>
                    <button name="action_mark_shipped" type="object" string="Mark Shipped" invisible="state != 'submitted'"/>
                    <button name="action_check_status" type="object" string="Check Status" invisible="state in ('draft','closed','cancelled')"/>
                    <button name="action_import_by_shipment_id" type="object" string="Import by Shipment ID" invisible="state != 'draft'"/>
                    <button name="action_get_labels" type="object" string="Get Labels" invisible="not shipment_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('closed','cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Shipment Info">
                            <field name="name"/>
                            <field name="instance_id"/>
                            <field name="shipment_id"/>
                            <field name="shipment_name"/>
                            <field name="destination_fulfillment_center"/>
                            <field name="label_prep_type"/>
                        </group>
                        <group string="Carrier &amp; Tracking">
                            <field name="carrier_type"/>
                            <field name="carrier_name"/>
                            <field name="tracking_id"/>
                            <field name="pro_number"/>
                            <field name="ship_date"/>
                            <field name="estimated_arrival"/>
                            <field name="picking_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="amazon_product_id"/>
                            <field name="odoo_product_id"/>
                            <field name="sku"/>
                            <field name="fnsku"/>
                            <field name="quantity_shipped"/>
                            <field name="quantity_received"/>
                            <field name="quantity_in_case"/>
                            <field name="quantity_discrepancy"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
