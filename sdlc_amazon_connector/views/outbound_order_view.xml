<odoo>
    <record id="amazon_outbound_order_action" model="ir.actions.act_window">
        <field name="name">MCF Outbound Orders</field>
        <field name="res_model">amazon.outbound.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="amazon_outbound_order_list" model="ir.ui.view">
        <field name="name">amazon.outbound.order.list</field>
        <field name="model">amazon.outbound.order</field>
        <field name="arch" type="xml">
            <list string="MCF Outbound Orders">
                <field name="name"/>
                <field name="fulfillment_order_id"/>
                <field name="sale_order_id"/>
                <field name="shipping_speed"/>
                <field name="state"/>
                <field name="dest_name"/>
                <field name="tracking_number"/>
                <field name="instance_id"/>
            </list>
        </field>
    </record>

    <record id="amazon_outbound_order_form" model="ir.ui.view">
        <field name="name">amazon.outbound.order.form</field>
        <field name="model">amazon.outbound.order</field>
        <field name="arch" type="xml">
            <form string="MCF Outbound Order">
                <header>
                    <button name="action_create_from_sale_order" type="object" string="Load from Sale Order" invisible="not sale_order_id or line_ids"/>
                    <button name="action_submit_to_amazon" type="object" string="Submit to Amazon" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check_status" type="object" string="Check Status" invisible="state in ('draft','delivered','cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('delivered','cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Order Info">
                            <field name="name"/>
                            <field name="instance_id"/>
                            <field name="sale_order_id"/>
                            <field name="fulfillment_order_id"/>
                            <field name="displayable_order_id"/>
                            <field name="shipping_speed"/>
                            <field name="displayable_comment"/>
                        </group>
                        <group string="Destination">
                            <field name="dest_name"/>
                            <field name="dest_address_line1"/>
                            <field name="dest_address_line2"/>
                            <field name="dest_city"/>
                            <field name="dest_state"/>
                            <field name="dest_postal_code"/>
                            <field name="dest_country_code"/>
                        </group>
                    </group>
                    <group string="Tracking">
                        <field name="carrier_name"/>
                        <field name="tracking_number"/>
                        <field name="estimated_arrival_date"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sku"/>
                            <field name="odoo_product_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
