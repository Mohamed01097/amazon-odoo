<odoo>
    <record id="amazon_vcs_action" model="ir.actions.act_window">
        <field name="name">VCS Tax Reports</field>
        <field name="res_model">amazon.vcs.tax.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="amazon_vcs_list" model="ir.ui.view">
        <field name="name">amazon.vcs.tax.report.list</field>
        <field name="model">amazon.vcs.tax.report</field>
        <field name="arch" type="xml">
            <list string="VCS Tax Reports">
                <field name="name"/>
                <field name="report_date"/>
                <field name="line_count"/>
                <field name="state"/>
                <field name="instance_id"/>
            </list>
        </field>
    </record>

    <record id="amazon_vcs_form" model="ir.ui.view">
        <field name="name">amazon.vcs.tax.report.form</field>
        <field name="model">amazon.vcs.tax.report</field>
        <field name="arch" type="xml">
            <form string="VCS Tax Report">
                <header>
                    <button name="action_download_report" type="object" string="Download Report" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_process_report" type="object" string="Process Report" invisible="state != 'downloaded'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="instance_id"/>
                        <field name="report_date"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="amazon_order_id"/>
                            <field name="amazon_invoice_number"/>
                            <field name="vat_number"/>
                            <field name="vat_amount"/>
                            <field name="invoice_amount"/>
                            <field name="currency_code"/>
                            <field name="invoice_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
