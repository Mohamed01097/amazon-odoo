<odoo>
    <record id="amazon_fba_sale_stock_event_list" model="ir.ui.view">
        <field name="name">amazon.fba.sale.stock.event.list</field>
        <field name="model">amazon.fba.sale.stock.event</field>
        <field name="arch" type="xml">
            <list decoration-danger="state in ('manual_review', 'failed')"
                  decoration-warning="state in ('pending', 'processing')">
                <field name="instance_id"/>
                <field name="amazon_order_ref"/>
                <field name="amazon_order_item_id"/>
                <field name="sku"/>
                <field name="product_id"/>
                <field name="amazon_cumulative_fulfilled_qty"/>
                <field name="processed_fulfilled_qty"/>
                <field name="last_delta_qty"/>
                <field name="state"/>
                <field name="attempt_count"/>
                <field name="next_run_at"/>
                <field name="last_processed_at"/>
            </list>
        </field>
    </record>

    <record id="amazon_fba_sale_stock_event_form" model="ir.ui.view">
        <field name="name">amazon.fba.sale.stock.event.form</field>
        <field name="model">amazon.fba.sale.stock.event</field>
        <field name="arch" type="xml">
            <form string="FBA Sale Stock Event" create="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="state not in ('manual_review', 'failed')"
                            groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,done,manual_review,failed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Amazon Evidence">
                            <field name="instance_id"/>
                            <field name="order_id"/>
                            <field name="order_line_id"/>
                            <field name="amazon_order_ref"/>
                            <field name="amazon_order_item_id"/>
                            <field name="sku"/>
                            <field name="product_id"/>
                            <field name="ordered_quantity"/>
                            <field name="amazon_evidence_updated_at"/>
                        </group>
                        <group string="Cumulative Processing">
                            <field name="amazon_cumulative_fulfilled_qty"/>
                            <field name="processed_fulfilled_qty"/>
                            <field name="last_delta_qty"/>
                            <field name="last_picking_id"/>
                            <field name="attempt_count"/>
                            <field name="max_attempts"/>
                            <field name="next_run_at"/>
                            <field name="last_processed_at"/>
                        </group>
                    </group>
                    <group string="Failure Evidence" invisible="not last_error_message">
                        <field name="last_error_code"/>
                        <field name="last_error_message"/>
                    </group>
                    <field name="picking_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="state"/>
                            <field name="date_done"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="amazon_fba_sale_stock_event_action" model="ir.actions.act_window">
        <field name="name">FBA Sale Stock Events</field>
        <field name="res_model">amazon.fba.sale.stock.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
