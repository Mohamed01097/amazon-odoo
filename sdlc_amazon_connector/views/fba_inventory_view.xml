<odoo>
    <record id="amazon_fba_inventory_action" model="ir.actions.act_window">
        <field name="name">FBA Inventory Reports</field>
        <field name="res_model">amazon.fba.inventory.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="amazon_fba_inventory_list" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.report.list</field>
        <field name="model">amazon.fba.inventory.report</field>
        <field name="arch" type="xml">
            <list string="FBA Inventory Reports">
                <field name="name"/>
                <field name="report_type"/>
                <field name="report_date"/>
                <field name="line_count"/>
                <field name="state"/>
                <field name="instance_id"/>
            </list>
        </field>
    </record>

    <record id="amazon_fba_inventory_form" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.report.form</field>
        <field name="model">amazon.fba.inventory.report</field>
        <field name="arch" type="xml">
            <form string="FBA Inventory Report">
                <header>
                    <button name="action_download_report" type="object" string="Download Report" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_process_report" type="object" string="Process Report" invisible="state != 'downloaded'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="instance_id"/>
                        <field name="report_type"/>
                        <field name="report_date"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="sku"/>
                            <field name="fnsku"/>
                            <field name="asin"/>
                            <field name="product_name"/>
                            <field name="condition"/>
                            <field name="quantity"/>
                            <field name="fulfillment_center_id"/>
                            <field name="reason"/>
                            <field name="odoo_product_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
