<odoo>
    <record id="amazon_fba_inventory_adjustment_action" model="ir.actions.act_window">
        <field name="name">Inventory Adjustments</field><field name="res_model">amazon.fba.inventory.adjustment</field><field name="view_mode">list,form</field>
    </record>
    <record id="amazon_fba_reimbursement_action" model="ir.actions.act_window">
        <field name="name">Reimbursements</field><field name="res_model">amazon.fba.reimbursement</field><field name="view_mode">list,form</field>
    </record>
    <record id="amazon_phase7_job_action" model="ir.actions.act_window">
        <field name="name">FBA &amp; Settlement Jobs</field><field name="res_model">amazon.phase7.job</field><field name="view_mode">list,form</field>
    </record>

    <record id="amazon_fba_inventory_adjustment_list" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.adjustment.list</field><field name="model">amazon.fba.inventory.adjustment</field>
        <field name="arch" type="xml">
            <list decoration-warning="manual_review_required">
                <field name="event_date"/><field name="reference_id"/><field name="sku"/><field name="fnsku"/>
                <field name="quantity"/><field name="reason_code"/><field name="event_category"/>
                <field name="disposition"/><field name="stock_action_state"/><field name="state"/><field name="instance_id"/>
            </list>
        </field>
    </record>
    <record id="amazon_fba_inventory_adjustment_form" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.adjustment.form</field><field name="model">amazon.fba.inventory.adjustment</field>
        <field name="arch" type="xml">
            <form><header><field name="state" widget="statusbar"/></header><sheet>
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object" name="action_view_stock_move" icon="fa-exchange" invisible="not stock_move_count"><field name="stock_move_count" widget="statinfo" string="Stock Move"/></button>
                    <button class="oe_stat_button" type="object" name="action_view_reimbursements" icon="fa-money" invisible="not reimbursement_count"><field name="reimbursement_count" widget="statinfo" string="Reimbursements"/></button>
                    <button class="oe_stat_button" type="object" name="action_view_sync_logs" icon="fa-history" invisible="not sync_log_count"><field name="sync_log_count" widget="statinfo" string="Sync Logs"/></button>
                </div>
                <widget name="web_ribbon" title="Manual Review" bg_color="text-bg-warning" invisible="not manual_review_required"/>
                <group><group><field name="instance_id"/><field name="event_date"/><field name="reference_id"/><field name="transaction_event_id"/><field name="reason_code"/><field name="event_category"/></group><group><field name="sku"/><field name="fnsku"/><field name="asin"/><field name="amazon_product_id"/><field name="odoo_product_id"/><field name="quantity"/><field name="disposition"/></group></group>
                <group><field name="reconciled_quantity"/><field name="unreconciled_quantity"/><field name="inventory_reflected"/><field name="stock_action_state"/><field name="linked_stock_move_id"/><field name="reversal_of_adjustment_id"/><field name="linked_reimbursement_id"/></group>
                <field name="review_reason" invisible="not review_reason"/><field name="raw_report_data" groups="sdlc_amazon_connector.group_amazon_technical_admin"/>
            </sheet><chatter/></form>
        </field>
    </record>

    <record id="amazon_fba_reimbursement_list" model="ir.ui.view">
        <field name="name">amazon.fba.reimbursement.list</field><field name="model">amazon.fba.reimbursement</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-warning="matching_state == 'unmatched'" decoration-danger="matching_state == 'ambiguous'">
                <field name="approval_date"/><field name="reimbursement_id"/><field name="reason_raw"/>
                <field name="sku"/><field name="odoo_product_id"/>
                <field name="quantity_reimbursed_cash"/><field name="quantity_reimbursed_inventory"/>
                <field name="quantity_reimbursed_total"/><field name="amount_total"/>
                <field name="currency_code"/><field name="matching_state"/><field name="instance_id"/>
            </list>
        </field>
    </record>
    <record id="amazon_fba_reimbursement_search" model="ir.ui.view">
        <field name="name">amazon.fba.reimbursement.search</field><field name="model">amazon.fba.reimbursement</field>
        <field name="arch" type="xml">
            <search string="FBA Reimbursements">
                <field name="reimbursement_id"/><field name="case_id"/><field name="amazon_order_id"/>
                <field name="sku"/><field name="fnsku"/><field name="asin"/><field name="amazon_product_id"/>
                <filter name="unmatched" string="Unmatched" domain="[('matching_state', '=', 'unmatched')]"/>
                <filter name="ambiguous" string="Ambiguous" domain="[('matching_state', '=', 'ambiguous')]"/>
                <filter name="unmapped" string="Unmapped Product" domain="[('product_mapping_state', '=', 'unmapped')]"/>
                <filter name="order_not_found" string="Order Not Found" domain="[('order_link_state', '=', 'order_not_found')]"/>
                <filter name="original_not_found" string="Original Not Found" domain="[('original_link_state', '=', 'not_found')]"/>
                <filter name="anomalies" string="Amount / Quantity Anomaly" domain="['|', ('quantity_anomaly', '=', True), ('amount_currency_anomaly', '=', True)]"/>
                <group>
                    <filter name="group_instance" string="Instance" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_reason" string="Reason" context="{'group_by': 'reason_raw'}"/>
                    <filter name="group_matching" string="Matching State" context="{'group_by': 'matching_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="amazon_fba_reimbursement_form" model="ir.ui.view">
        <field name="name">amazon.fba.reimbursement.form</field><field name="model">amazon.fba.reimbursement</field>
        <field name="arch" type="xml">
            <form create="0" delete="0"><header>
                <button name="action_match" type="object" string="Retry Automatic Match" class="btn-primary" invisible="matching_state in ('matched', 'manually_matched', 'ignored')" groups="sdlc_amazon_connector.group_amazon_manager"/>
                <button name="action_confirm_manual_match" type="object" string="Confirm Manual Inventory Match" invisible="not linked_inventory_event_id or matching_state in ('matched', 'manually_matched', 'ignored')" groups="sdlc_amazon_connector.group_amazon_manager"/>
                <field name="matching_state" widget="statusbar"/>
            </header><sheet>
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object" name="action_view_amazon_order" icon="fa-shopping-cart" invisible="not amazon_order_count"><field name="amazon_order_count" widget="statinfo" string="Amazon Order"/></button>
                    <button class="oe_stat_button" type="object" name="action_view_sale_order" icon="fa-file-text-o" invisible="not sale_order_count"><field name="sale_order_count" widget="statinfo" string="Sale Order"/></button>
                    <button class="oe_stat_button" type="object" name="action_view_amazon_product" icon="fa-cube" invisible="not amazon_product_id"><span>Amazon Product</span></button>
                    <button class="oe_stat_button" type="object" name="action_view_odoo_product" icon="fa-cubes" invisible="not odoo_product_id"><span>Odoo Product</span></button>
                    <button class="oe_stat_button" type="object" name="action_view_return" icon="fa-undo" invisible="not return_count"><field name="return_count" widget="statinfo" string="Customer Return"/></button>
                    <button class="oe_stat_button" type="object" name="action_view_adjustment" icon="fa-balance-scale" invisible="not adjustment_count"><field name="adjustment_count" widget="statinfo" string="Adjustment"/></button>
                    <button class="oe_stat_button" type="object" name="action_view_removal_order" icon="fa-truck" invisible="not removal_order_count"><field name="removal_order_count" widget="statinfo" string="Removal Order"/></button>
                    <button class="oe_stat_button" type="object" name="action_view_original_reimbursement" icon="fa-link" invisible="not original_reimbursement_count"><field name="original_reimbursement_count" widget="statinfo" string="Original"/></button>
                    <button class="oe_stat_button" type="object" name="action_view_reversal_reimbursements" icon="fa-random" invisible="not reversal_reimbursement_count"><field name="reversal_reimbursement_count" widget="statinfo" string="Reversals"/></button>
                    <button class="oe_stat_button" type="object" name="action_view_sync_logs" icon="fa-history" invisible="not sync_log_count"><field name="sync_log_count" widget="statinfo" string="Sync Logs"/></button>
                </div>
                <widget name="web_ribbon" title="Review Required" bg_color="text-bg-warning" invisible="not requires_review"/>
                <group string="Amazon Identifiers"><group><field name="instance_id" readonly="1"/><field name="company_id" readonly="1"/><field name="marketplace_id" readonly="1"/><field name="approval_date" readonly="1"/><field name="reimbursement_id" readonly="1"/><field name="case_id" readonly="1"/><field name="reason_raw" readonly="1"/><field name="reimbursement_classification" readonly="1"/><field name="condition" readonly="1"/></group><group><field name="amazon_order_id" readonly="1"/><field name="amazon_order_record_id" readonly="1"/><field name="order_link_state" readonly="1"/><field name="sku" readonly="1"/><field name="fnsku" readonly="1"/><field name="asin" readonly="1"/><field name="product_name" readonly="1"/><field name="amazon_product_id" readonly="1"/><field name="odoo_product_id" readonly="1"/><field name="product_mapping_state" readonly="1"/></group></group>
                <group string="Amazon-Reported Compensation"><group><field name="quantity_reimbursed_cash" readonly="1"/><field name="quantity_reimbursed_inventory" readonly="1"/><field name="quantity_reimbursed_total" readonly="1"/><field name="has_reported_quantity_total" readonly="1"/><field name="quantity_anomaly" readonly="1"/></group><group><field name="amount_per_unit" readonly="1"/><field name="amount_total" readonly="1"/><field name="currency_code" readonly="1"/><field name="currency_id" readonly="1"/><field name="amount_currency_anomaly" readonly="1"/><field name="financial_state" readonly="1"/></group></group>
                <group string="Original / Reversal"><field name="original_reimbursement_id" readonly="1"/><field name="original_reimbursement_type" readonly="1"/><field name="original_reimbursement_record_id" readonly="1"/><field name="original_link_state" readonly="1"/></group>
                <group string="Operational Matching"><field name="linked_inventory_event_id" domain="[('instance_id', '=', instance_id)]" groups="sdlc_amazon_connector.group_amazon_manager" readonly="matching_state in ('matched', 'manually_matched', 'ignored')"/><field name="linked_return_id" readonly="1"/><field name="linked_removal_order_id" readonly="1"/><field name="match_method" readonly="1"/><field name="matching_explanation" readonly="1"/><field name="requires_review" readonly="1"/><field name="review_note" readonly="1"/></group>
                <group string="Future Financial Link (No Posting)"><field name="linked_settlement_id" readonly="1"/></group>
                <group string="Import Diagnostic"><field name="source_report_id" readonly="1"/><field name="line_key" readonly="1"/><field name="imported_at" readonly="1"/><field name="last_synced_at" readonly="1"/><field name="last_match_attempt_at" readonly="1"/></group>
                <field name="raw_report_row" readonly="1" groups="sdlc_amazon_connector.group_amazon_technical_admin"/>
            </sheet><chatter/></form>
        </field>
    </record>

    <record id="amazon_phase7_job_list" model="ir.ui.view">
        <field name="name">amazon.phase7.job.list</field><field name="model">amazon.phase7.job</field>
        <field name="arch" type="xml"><list decoration-danger="state == 'failed'"><field name="name"/><field name="operation_type"/><field name="stage"/><field name="state"/><field name="total_found"/><field name="total_processed"/><field name="total_failed"/><field name="retry_count"/><field name="next_run_at"/><field name="instance_id"/></list></field>
    </record>
    <record id="amazon_phase7_job_form" model="ir.ui.view">
        <field name="name">amazon.phase7.job.form</field><field name="model">amazon.phase7.job</field>
        <field name="arch" type="xml"><form><header><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="instance_id"/><field name="operation_type"/><field name="stage"/><field name="date_from"/><field name="date_to"/></group><group><field name="amazon_report_id"/><field name="amazon_request_id"/><field name="feed_id"/><field name="retry_count"/><field name="next_run_at"/><field name="started_at"/><field name="finished_at"/></group></group><group><field name="total_found"/><field name="total_processed"/><field name="total_failed"/><field name="last_error_code"/></group><field name="last_error_message"/><field name="row_error_log" invisible="not row_error_log" groups="sdlc_amazon_connector.group_amazon_manager"/><field name="raw_document" groups="sdlc_amazon_connector.group_amazon_technical_admin"/></sheet><chatter/></form></field>
    </record>
</odoo>
