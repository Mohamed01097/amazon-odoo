<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="amazon_fba_schedule_appointment_wizard_form" model="ir.ui.view">
        <field name="name">amazon.fba.schedule.appointment.wizard.form</field>
        <field name="model">amazon.fba.schedule.appointment.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule FC Appointment">
                <field name="physical_shipment_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    This will schedule the selected appointment with Amazon.
                    Review the details below and press <b>Confirm Schedule</b> to send
                    the request. This is a real Amazon write operation.
                </div>
                <group>
                    <field name="destination_fc"/>
                    <field name="amazon_slot_id"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                    <field name="duration_minutes"/>
                </group>
                <footer>
                    <button name="action_confirm_schedule" type="object"
                            string="Confirm Schedule"
                            class="btn-primary"
                            groups="sdlc_amazon_connector.group_amazon_manager"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
