<odoo>
    <record id="amazon_removal_order_action" model="ir.actions.act_window">
        <field name="name">Removal Orders</field>
        <field name="res_model">amazon.removal.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="amazon_removal_order_list" model="ir.ui.view">
        <field name="name">amazon.removal.order.list</field>
        <field name="model">amazon.removal.order</field>
        <field name="arch" type="xml">
            <list string="Removal Orders">
                <field name="name"/>
                <field name="removal_order_id"/>
                <field name="order_type"/>
                <field name="state"/>
                <field name="line_count"/>
                <field name="instance_id"/>
            </list>
        </field>
    </record>

    <record id="amazon_removal_order_form" model="ir.ui.view">
        <field name="name">amazon.removal.order.form</field>
        <field name="model">amazon.removal.order</field>
        <field name="arch" type="xml">
            <form string="Removal Order">
                <header>
                    <button name="action_submit_to_amazon" type="object" string="Submit to Amazon" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check_status" type="object" string="Check Status" invisible="state in ('draft','completed','cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed','cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="instance_id"/>
                            <field name="removal_order_id"/>
                        </group>
                        <group>
                            <field name="order_type"/>
                            <field name="ship_to_address" invisible="order_type != 'Return'"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="amazon_product_id"/>
                            <field name="sku"/>
                            <field name="fnsku"/>
                            <field name="disposition"/>
                            <field name="requested_quantity"/>
                            <field name="shipped_quantity"/>
                            <field name="cancelled_quantity"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
