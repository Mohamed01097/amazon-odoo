<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="amazon_fba_transportation_ready_to_ship_wizard_form" model="ir.ui.view">
        <field name="name">amazon.fba.transportation.ready.to.ship.wizard.form</field>
        <field name="model">amazon.fba.transportation.ready.to.ship.wizard</field>
        <field name="arch" type="xml">
            <form string="Ready-to-Ship Date/Time">
                <field name="operation_type" invisible="1"/>
                <field name="shipment_count" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    Enter the earliest date/time when all cartons are packed, labeled, staged and
                    available for carrier pickup. It must be at least
                    <field name="min_lead_minutes" class="oe_inline" readonly="1"/>
                    minutes in the future. Amazon generates transportation options for every
                    accepted physical shipment of the placement option in a single request.
                </div>
                <div class="alert alert-warning" role="alert" invisible="operation_type != 'regenerate'">
                    Regenerating transportation options discards the current unconfirmed
                    transportation selection and replaces the existing options.
                </div>
                <group>
                    <field name="physical_shipment_id" readonly="1" force_save="1"/>
                    <field name="ready_to_ship_at"
                           invisible="shipment_count &gt; 1"
                           required="shipment_count &lt;= 1"/>
                </group>
                <field name="line_ids" invisible="shipment_count &lt;= 1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="physical_shipment_id" column_invisible="1"/>
                        <field name="amazon_shipment_id"/>
                        <field name="shipment_confirmation_id"/>
                        <field name="destination_fc"/>
                        <field name="ready_to_ship_at" required="parent.shipment_count &gt; 1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Generate Transportation Options"
                            class="btn-primary"
                            groups="sdlc_amazon_connector.group_amazon_manager"
                            invisible="operation_type != 'generate'"/>
                    <button name="action_confirm" type="object"
                            string="Regenerate Transportation Options"
                            class="btn-primary"
                            groups="sdlc_amazon_connector.group_amazon_manager"
                            invisible="operation_type != 'regenerate'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
