<odoo>
    <record id="view_wix_order_import_job_form" model="ir.ui.view">
        <field name="name">wix.order.import.job.form</field>
        <field name="model">wix.order.import.job</field>
        <field name="arch" type="xml">
            <form string="Wix Order Import Job">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="event_slug"/>
                            <field name="wix_order_id"/>
                            <field name="wix_event_id"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group>
                            <field name="next_run_at"/>
                            <field name="retry_count"/>
                            <field name="sync_log_id"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error_message">
                        <field name="last_error_message" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Raw Payload">
                            <field name="payload_json" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wix_order_import_job_list" model="ir.ui.view">
        <field name="name">wix.order.import.job.list</field>
        <field name="model">wix.order.import.job</field>
        <field name="arch" type="xml">
            <list string="Wix Order Import Jobs">
                <field name="create_date"/>
                <field name="instance_id"/>
                <field name="event_slug"/>
                <field name="wix_order_id"/>
                <field name="sale_order_id"/>
                <field name="retry_count"/>
                <field name="state"
                       decoration-danger="state == 'failed'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_wix_order_import_job_search" model="ir.ui.view">
        <field name="name">wix.order.import.job.search</field>
        <field name="model">wix.order.import.job</field>
        <field name="arch" type="xml">
            <search string="Wix Order Import Jobs">
                <field name="wix_order_id"/>
                <field name="instance_id"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'draft')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_instance" string="Connection" domain="[]" context="{'group_by': 'instance_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wix_order_import_job" model="ir.actions.act_window">
        <field name="name">Order Import Jobs</field>
        <field name="res_model">wix.order.import.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
