<odoo>
    <record id="module_category_sdlc_wix_connector" model="ir.module.category">
        <field name="name">Wix Connector</field>
        <field name="sequence">36</field>
    </record>

    <record id="res_groups_privilege_wix_connector" model="res.groups.privilege">
        <field name="name">Wix Connector</field>
        <field name="category_id" ref="module_category_sdlc_wix_connector"/>
        <field name="sequence">36</field>
    </record>

    <record id="group_wix_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_wix_connector"/>
    </record>

    <record id="group_wix_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_wix_connector"/>
        <field name="implied_ids" eval="[
            Command.link(ref('sdlc_wix_connector.group_wix_user')),
            Command.link(ref('sales_team.group_sale_salesman')),
        ]"/>
    </record>

    <record id="group_wix_technical_admin" model="res.groups">
        <field name="name">Technical Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_wix_connector"/>
        <field name="implied_ids" eval="[
            Command.link(ref('sdlc_wix_connector.group_wix_manager')),
            Command.link(ref('base.group_system')),
        ]"/>
    </record>

    <record id="rule_wix_instance_company" model="ir.rule">
        <field name="name">Wix instances by company</field>
        <field name="model_id" ref="model_wix_instance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('sdlc_wix_connector.group_wix_user'))]"/>
    </record>

    <record id="rule_wix_order_import_job_company" model="ir.rule">
        <field name="name">Wix order import jobs by company</field>
        <field name="model_id" ref="model_wix_order_import_job"/>
        <field name="domain_force">[('instance_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('sdlc_wix_connector.group_wix_user'))]"/>
    </record>

    <record id="rule_wix_sync_log_company" model="ir.rule">
        <field name="name">Wix sync logs by company</field>
        <field name="model_id" ref="model_wix_sync_log"/>
        <field name="domain_force">[('instance_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('sdlc_wix_connector.group_wix_user'))]"/>
    </record>
</odoo>
